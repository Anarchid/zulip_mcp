{
  "name": "zulip-mcp-server",
  "version": "2.2.1",
  "description": "Stateful, ergonomic MCP server for Zulip and Discord with ambient awareness, persistent monitoring, and natural date-based queries",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "zulip-mcp-server": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --import tsx --test test/*.test.ts",
    "version": "node scripts/release-changelog.mjs && git add CHANGELOG.md changelog.d",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "zulip",
    "discord",
    "model-context-protocol",
    "chat",
    "messaging",
    "stateful",
    "ai",
    "assistant",
    "cursor",
    "claude"
  ],
  "author": "Antra Tessera",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "zuliprc.example"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.16.0",
    "discord.js": "^14.16.3",
    "zulip-js": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
