# --- Platform selection -----------------------------------------------------
ENABLE_ZULIP=true            # enabled by default; set "false" to disable
ENABLE_DISCORD=false
ENABLE_SLACK=false

# --- Zulip -------------------------------------------------------------------
ZULIP_REALM=https://your-org.zulipchat.com
ZULIP_EMAIL=your-bot@example.com
ZULIP_API_KEY=your-api-key
#ZULIP_RC_PATH=/path/to/zuliprc      # alternative to the three vars above
#ZULIP_SESSION_ID=agent_name         # persistent monitoring state id
#ZULIP_SUBSCRIBE=general,random      # auto-subscribe streams on startup

# --- Discord -----------------------------------------------------------------
#DISCORD_TOKEN=your-bot-token

# --- Slack -------------------------------------------------------------------
#SLACK_BOT_TOKEN=xoxb-...            # Bot User OAuth Token (Web API)
#SLACK_APP_TOKEN=xapp-...            # App-level token with connections:write (Socket Mode)
#SLACK_SESSION_ID=agent_name         # persistent monitoring state id (defaults to workspace)

# --- MCPL (MCP Live) ---------------------------------------------------------
MCPL_ENABLED=true                    # set "false" for plain MCP mode
#MCPL_BATCH_WINDOW_MS=500            # incoming message batching window
#MCPL_CONTEXT_HISTORY_SIZE=20        # messages injected per open channel
