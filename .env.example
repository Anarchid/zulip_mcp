# --- Zulip credentials --------------------------------------------------------
ZULIP_REALM=https://your-org.zulipchat.com
ZULIP_EMAIL=your-bot@example.com
ZULIP_API_KEY=your-api-key
#ZULIP_RC_PATH=/path/to/zuliprc      # alternative to the three vars above

# --- Identity & state --------------------------------------------------------
#ZULIP_SESSION_ID=agent_name         # keys the state files (default: bot email, from env or zuliprc)
#ZULIP_STATE_DIR=~/.zulip_mcp_state  # monitoring + delivery + filters files — on storage that survives a redeploy
#ZULIP_SUBSCRIBE=general,random      # subscribe the bot to these streams on startup

# --- Filters plane (hot-reloaded; env values only seed the file once) --------
#ZULIP_FILTERS_FILE=/etc/agent/zulip-filters.json   # default <state dir>/<session>.filters.json
#ZULIP_STREAMS=general,dev           # stream allowlist (unset = every visible stream)
#ZULIP_DM_USERS=42,ann@example.com   # who may DM the bot (unset/empty = anyone)
#ZULIP_MUTED_STREAMS=random          # nothing from these reaches the agent
#ZULIP_SUPPRESSED_REACTIONS_BASELINE=biohazard   # host-owned reaction markers, applied every start, never persisted
                                     # (falls back to DISCORD_SUPPRESSED_REACTIONS_BASELINE, which connectome-host injects)

# --- Delivery ----------------------------------------------------------------
#ZULIP_CATCHUP_LIMIT=3000            # per-channel ceiling for catch-up / gap recovery (max 10000)
#ZULIP_MISSED_BLOCK_MAX_CHARS=40000  # size cap on one <missed> block (oldest lines elided)
#ZULIP_BACKSCROLL_DEFAULT=500        # history cap on channels/open
#ZULIP_BACKSCROLL_CHANNELS=general:50,dev:200
#ZULIP_MAX_MESSAGE_LENGTH=10000      # the realm's limit; longer sends are split
#ZULIP_INLINE_IMAGES=true            # inline images on live delivery (downsampled)
#ZULIP_INLINE_IMAGES_MAX=4           # images inlined per message
#ZULIP_ATTACHMENT_INLINE_MAX_BYTES=5120   # text attachments inlined at or under this (max 262144)
#AGENT_TIMEZONE=Europe/Helsinki      # IANA zone for agent-visible timestamps
#AGENT_TIMESTAMP_STYLE=full          # full | compact | time | none

# --- MCPL (MCP Live) ---------------------------------------------------------
MCPL_ENABLED=true                    # set "false" for plain MCP mode
#MCPL_BATCH_WINDOW_MS=500            # channels/incoming batching window
#MCPL_CONTEXT_HISTORY_SIZE=20        # messages injected per open channel
